            </div>

            <!-- Remember Me -->
            <flux:checkbox name="remember" :label="__('Angemeldet bleiben')" :checked="old('remember')" />

            <div class="flex items-center justify-end">
                <flux:button variant="primary" type="submit" class="w-full" data-test="login-button">
